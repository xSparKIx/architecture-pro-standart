@startuml context_diagram

!include ../templates/C4_Context.puml

title Диаграмма контекста - Цифровизация депозитов

Person(client, "Клиент", "Пользователь цифровых услуг банка")
Person(manager, "Сотрудник банка", "Сотрудник депозитного отделов банка")
Person(CallManager, "Менеджер кол-центра", "Менеджер кол-центра по офомлению заявок клиентов")

System(site, "Сайт банка", "Веб-сайт для новых клиентов с базовой информацией о продуктах")
System(InternetBank, "Интернет-банк", "Личный кабинет для существующих клиентов с полным функционалом")
System(abc, "АБС банка", "Автоматизированная банковская система - ядро банковских операций")
System(CallCenter, "Система колл-центра", "CRM система для обработки входящих заявок")
System(SMSGateway, "СМС-шлюз", "Сервис отправки SMS-сообщений клиентам")
System_Ext(SMSService, "Телеком-оператор", "Отправляет СМС пользователям")

SystemQueue(broker, "Kafka")

' Связи клиента
Rel(client, site, "Просматривает предложения, проходит регистрацию, подает заявку")
Rel(client, InternetBank, "Просматривает информацию по личному кабинету и подает заявку")
Rel(SMSService, client, "Доставляет уведомления клиенту")

' Связи кол-центра
Rel(site, broker, "Передает заявку с сайта")
Rel(CallManager, CallCenter, "Обрабатывает заявку и связывается с клиентом для оформления")
Rel(CallCenter, broker, "Получает первичные заявки и передает актуальные сведения о заявке и клиенте")

' Связи АБС
Rel(manager, abc, "Обрабатывает заявку")
Rel(abc, SMSGateway, "Отправляет уведомления")
Rel(abc, broker, "Передает актуальную информацию о продуктах и заявках")

' Связи интернет-банка
Rel(InternetBank, broker, "Передает заявки, получает актуальную информацию о ставках, предложениях, решениях")

Rel(SMSGateway, SMSService, "Передает уведомления для отправки")

@enduml